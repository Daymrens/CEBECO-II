# =====================================================================
# CEBECO II Outage Portal — Environment Variables
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# `.env` is gitignored and must never be committed.
# =====================================================================

# Supabase project URL, e.g. https://yourproject.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public API key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend API key — used by Phase 4 (email alerts). Placeholder for now.
RESEND_API_KEY=