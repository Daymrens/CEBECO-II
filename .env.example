# =====================================================================
# CEBECO II Outage Portal — Environment Variables
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must never be committed.
# =====================================================================

# Supabase project URL, e.g. https://yourproject.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public API key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend API key — used by Phase 4 (email alerts). Placeholder for now.
RESEND_API_KEY=

# ---------------------------------------------------------------------
# Phase 2 — Auth + Data store
# ---------------------------------------------------------------------

# Secret used to sign admin session JWTs (HS256). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED in production. Falls back to a dev-only key when unset.
AUTH_SECRET=

# Postgres connection string. When set, the app uses the Postgres adapter
# (create the schema first: supabase/schema.sql + supabase/seed.sql).
# When unset, the app runs on the local JSON-file store (data/db.json).
DATABASE_URL=

# Optional: override the JSON store file path (default: data/db.json).
# DATA_FILE=